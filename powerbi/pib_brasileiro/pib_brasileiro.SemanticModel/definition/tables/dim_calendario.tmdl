	partition dim_calendario = m
		mode: import
		source =
				let
						    Fonte = Csv.Document ( File.Contents ( PastaDados & "/dim_calendario.csv" ), [ Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv ] ),
						    Cabecalho = Table.PromoteHeaders ( Fonte, [ PromoteAllScalars = true ] ),
						    Tipos = Table.TransformColumnTypes ( Cabecalho, { { "ano", Int64.Type }, { "trimestre", Int64.Type }, { "mes", Int64.Type }, { "dia", Int64.Type }, { "data", type date }, { "eh_fim_trimestre", type logical }, { "ano_parcial", type logical } }, "en-US" )
						in
						    Tipos

